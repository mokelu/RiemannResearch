# =====================================================================
#  Redraw.ab   ·   shared terminal behavior
# =====================================================================
#  reached by:   UserOpensFile, UserClosesFile, UserCreatesFile,
#                UserCreatesFolder, UserRenamesFile, UserRenamesFolder,
#                UserDeletesFile, UserDeletesFolder, UserDuplicatesFile,
#                UserMovesFile, UserMovesFolder,
#                UserExpandsFolder, UserCollapsesFolder,
#                UserExpandsAll, UserCollapsesAll, UserSearchesTree,
#                UserCopiesPath,
#                UserSelectsView, UserAddsMaterial, UserAddsSentence,
#                UserEditsSentence, UserTagsSentence,
#                UserConnectsSentence, UserDeletesSentence,
#                UserLoadsExample, UserSendsMessage, UserStartsChat,
#                UserTogglesPanels, UserTogglesChat
#                (NOT UserSelectsNode — it halts; nothing structural
#                changed, so it repaints nothing.  see its header.)
#
#  v4 equivalence:  renderTree() + renderTabs() + renderEditor()
#                   + updateStats()
#  app status:      PARTIAL — src/ paints tree, editor and stats on
#                   every React commit.  there is no tab strip in the
#                   app (one open file, its name lives in the header),
#                   so `system render tab` has no surface yet.  the
#                   step stays: the spec is allowed to be ahead of
#                   the build (ReportFailure has the same note).
#
#  v4 detail worth knowing:  renderTree() already CALLS updateStats()
#  (leftpanel_v4.html line 356), so the panel gets its counters "for
#  free".  here the four paints are written out as four steps on
#  purpose.  a free call cannot fail loudly and cannot be traced.  the
#  machine needs to see each paint as its own event so I7 can blame
#  the one that broke.
#
#  the term is `system render tab`, singular, because the alphabet
#  declares ONE resource Tab — "the open-file strip".  the strip is
#  repainted as a whole.  grammar does not let a term carry a plural
#  the alphabet has not declared, which is the point of declaring.
#
#  `system update stats` catches ok ONLY: Update is an in-memory flip
#  (alphabet.ab, THE LINE).  there is no stats.update.failed to catch.
#
#  every path into this behavior leaves through `halt`.  Redraw is
#  terminal (grammar.ab R5).

behavior Redraw

step system render tree
  catch tree.render.ok     goto system render tab
  catch tree.render.failed goto halt

step system render tab
  catch tab.render.ok     goto system render editor
  catch tab.render.failed goto halt

step system render editor
  catch editor.render.ok     goto system render chat
  catch editor.render.failed goto halt

#  one React commit paints the whole tree, chat included — so the
#  thread is repainted here too, with the same two results as every
#  other paint.
step system render chat
  catch chat.render.ok     goto system update stats
  catch chat.render.failed goto halt

step system update stats
  catch stats.update.ok     halt
