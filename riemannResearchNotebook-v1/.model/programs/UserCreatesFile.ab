# =====================================================================
#  UserCreatesFile.ab
# =====================================================================
#  sentence   User Create File
#  v4         createNode(currentTarget(), 'file')  — IMPLEMENTED
#             leftpanel_v4.html line 563; wired at line 859 (header),
#             762 (folder context menu), empty-area menu.
#  triggers   header "New File" button · tree context menu "New File"
#             empty-area context menu "New File"
#
#  reuse      grammar R6 fixes `enter`: User Create File
#             -> file.create.requested.  the fourth column is never
#             written by hand.
#
#  the folder question.  WHICH folder the file goes into is not
#  decided by the trigger.  it is decided by ResolveTargetFolder,
#  the visible form of v4's currentTarget() (line 863):
#       selected row is a folder   -> that folder
#       selected row is a file     -> its parent
#       nothing selected           -> root
#  v4 answers it in three lines.  here it is a step with its own
#  response, because that is what the machine has to be able to see.

program UserCreatesFile

sentence  User Create File
enter     file.create.requested

step system resolve folder
  catch folder.resolve.selected goto system create file onto folder
  catch folder.resolve.root      goto system create file onto folder

step system create file onto folder
  catch file.create.ok       goto system expand folder
  catch file.create.invalid  goto ReportFailure
  catch file.create.failed   goto ReportFailure

# the app expands the parent so the new row is actually visible
# (LeftPanel.jsx:215 `if (parentId) expand(parentId)`); v4 did the
# same (line 571).  a create the person cannot see did not happen.
step system expand folder
  catch folder.expand.ok goto system select node

step system select node
  catch node.select.ok goto system begin edit

step system begin edit
  catch edit.begin.ok     goto system rename file
  catch edit.begin.failed goto Redraw

# suspends until Enter, Esc, or blur.
#   a name typed         -> the new file keeps it        (ok)
#   empty name committed -> renamed to "Untitled"        (ok)
#                          product decision, LeftPanel:236-238:
#                          "an entry a stranger just created is
#                          never thrown away under them."
#                          v4 discarded on empty (line 534);
#                          the app keeps it.  the app is the
#                          source of truth — README.
#   Esc                  -> cancelled -> the new file is
#                          discarded (LeftPanel:246-247)
#   boundary refusal     -> invalid: no name rules are wired
#                          today, so it never fires; if it ever
#                          does, the node is KEPT and redraws as
#                          "untitled".  a refusal is never a
#                          reason to destroy work.
#
# `exists` goes to Redraw rather than ReportFailure because there is
# nothing to report yet: the rename input is still open and the
# person can simply type a different name.  v4 never reaches this
# branch at all — commitEdit() has no sibling-name check.  declared,
# specified, not built.
step system rename file
  catch file.rename.ok        goto Redraw
  catch file.rename.invalid   goto Redraw
  catch file.rename.cancelled goto system delete node
  catch file.rename.exists    goto Redraw

step system delete node
  catch node.delete.ok     goto Redraw
  catch node.delete.failed goto ReportFailure
