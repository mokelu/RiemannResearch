# =====================================================================
#  UserOpensFile.ab
# =====================================================================
#  sentence   User Open File
#  v4         openFile(id)  — PARTIAL
#             v4 only pushes a tab and renders.  validate / load /
#             update / focus are specified here and not yet built.
#  triggers   click on a file row · Enter on a selected file
#             context menu "Open" · the row "more" menu

program UserOpensFile

sentence  User Open File
enter     file.open.requested

step system validate file
  catch file.validate.ok            goto system load file
  catch file.validate.already_open  goto system focus editor
  catch file.validate.invalid       goto ReportFailure

step system load file
  catch file.load.ok      goto system update editor
  catch file.load.failed  goto ReportFailure

step system update editor
  catch editor.update.ok     goto system focus editor
  catch editor.update.failed goto ReportFailure

step system focus editor
  catch editor.focus.ok     goto Redraw
  catch editor.focus.failed goto ReportFailure
