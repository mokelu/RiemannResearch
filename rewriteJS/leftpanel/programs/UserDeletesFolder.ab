# =====================================================================
#  UserDeletesFolder.ab
# =====================================================================
#  sentence   User Delete Folder
#  v4         deleteNode(id) + showConfirm(...)  — IMPLEMENTED
#             leftpanel_v4.html line 580; dialog at line 799.
#  triggers   context menu "Delete" (line 766) · Del · Backspace
#             (lines 885-886)
#
#  the WORDING differs from the file case in v4 (line 586-588):
#    file    "This file will be removed. This cannot be undone."
#    folder  "The folder and everything inside it will be removed."
#  wording is presentation.  branching is this program.  the only
#  change from UserDeletesFile is the resource: File -> Folder.

program UserDeletesFolder

sentence  User Delete Folder
enter     folder.delete.requested

# suspends for a click, overlay click, or Esc (lines 815-817, 822-824).
step system confirm dialog
  catch dialog.confirm.accepted  goto system delete folder
  catch dialog.confirm.cancelled goto halt

# v4 collects the whole subtree (line 590), splices it out (591-592),
# then drops every tab whose id is inside that subtree (594).  for a
# folder that can be several tabs at once; the step emits once per
# tab the machine actually removes.
step system delete folder
  catch folder.delete.ok     goto system close tab
  catch folder.delete.failed goto ReportFailure

step system close tab
  catch tab.close.ok     goto Redraw
  catch tab.close.failed goto Redraw
